# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# --- Database ---
POSTGRES_DB=printquote
POSTGRES_USER=printquote
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Images ---
# Leave as is to build on the server with `docker compose build`, or point at
# your registry, e.g. API_IMAGE=registry.example.com/printquote-api
API_IMAGE=printquote-api
WEB_IMAGE=printquote-web
IMAGE_TAG=latest
# Where the frontend repo is checked out, relative to this folder (build only).
FRONTEND_DIR=../../printquote-frontend

# --- Web ---
# Host port for the app. Put HTTPS (reverse proxy or load balancer) in front.
# Use WEB_BIND=127.0.0.1 when that proxy runs on the same host.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# --- API ---
MIGRATE_ON_STARTUP=true
LOG_LEVEL=Information
